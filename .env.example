# Canonical public URL for share links (production domain). Falls back to window.location.origin in dev.
# Also used by the API at GET /api/public-config as appPublicOrigin.
VITE_PUBLIC_APP_ORIGIN=https://levelup-productivity-web-app.vercel.app
APP_PUBLIC_ORIGIN=https://levelup-productivity-web-app.vercel.app

# PostHog product analytics (https://posthog.com)
# Get your project API key from PostHog → Project Settings → Project API Key
# Vite embeds VITE_* at build time (localhost + Vercel). The API also serves these at
# GET /api/public-config so production works when only the Render backend has the key.
VITE_POSTHOG_KEY=phc_your_project_api_key
# Optional server-only alias (used by /api/public-config if VITE_POSTHOG_KEY is unset on Render)
POSTHOG_KEY=phc_your_project_api_key
# US cloud (default): https://us.i.posthog.com | EU cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
